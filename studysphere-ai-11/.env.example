# Copy to .env (or set in your hosting provider's build environment).
# Without these, the app targets the local dev backend.

# Backend API origin (no trailing slash, no /api suffix)
VITE_API_URL=http://localhost:8000

# WebSocket origin for chat + collaborative workspace (wss:// in production)
VITE_WS_URL=ws://localhost:8000

# Google Sign-In OAuth Client ID (not a secret — it's a public identifier
# shipped to the browser either way). The Google button renders only
# when this is set; leave unset to run without Google sign-in.
#VITE_GOOGLE_CLIENT_ID=
