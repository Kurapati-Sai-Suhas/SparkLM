# SparkLM backend environment — copy to .env (this folder, next to
# manage.py) and fill in. Production values go into the Render dashboard
# instead (see render.yaml: sync:false keys + docs/DEPLOYMENT.md).

# ── Core ─────────────────────────────────────────────────────
# Required in production; dev falls back to a well-known key and refuses
# to boot with it once DJANGO_DEBUG=false.
SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

# ── Database (defaults match docker-compose Postgres) ───────
POSTGRES_DB=learnlm_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=yourpassword
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# ── Cache / channel layer ────────────────────────────────────
# Unset = per-process LocMem (fine for single-process dev).
# Production: Upstash TLS URL, e.g. rediss://default:<pass>@<host>:6379
#REDIS_URL=

# ── Cross-origin ─────────────────────────────────────────────
# Dev default already covers localhost:3000/5173/8080.
# Production: your SPA origin(s), comma-separated.
#CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
# Production admin over HTTPS needs the API origin trusted for CSRF:
#CSRF_TRUSTED_ORIGINS=https://your-api.onrender.com

# Reverse proxies in front of the app (throttle identity, see settings).
DRF_NUM_PROXIES=1

# ── Third-party APIs ─────────────────────────────────────────
JUDGE0_API_KEY=
JUDGE0_API_HOST=judge0-extra-ce.p.rapidapi.com
GROQ_API_KEY=
# Optional backup: used only when Groq's daily token quota is hit, so
# content-generation commands (reseed_questions, backfill_boilerplate)
# don't have to stop for the day. Unset = Groq's daily cap still stops
# things cleanly, exactly as before.
NIM_API_KEY=
GEMINI_API_KEY=

# Google Sign-In: the OAuth Client ID from Google Cloud Console (not a
# secret — matches VITE_GOOGLE_CLIENT_ID on the frontend). Unset = the
# /api/auth/google/ endpoint returns 503 rather than accepting tokens
# with no audience to verify against.
GOOGLE_CLIENT_ID=

# Optional: LLM coach hints webhook (fallback hints without it).
#N8N_WEBHOOK_URL=

# ── ML extras (requires requirements-ml.txt installed) ──────

# ── Email (optional) ─────────────────────────────────────────
#EMAIL_HOST_USER=
#EMAIL_HOST_PASSWORD=
